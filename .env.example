# Copy this file as .env and replace the example values.
# Never commit the real .env file.

# Root directory containing the extracted MURA-v1.1 dataset
XRAY_DATA_ROOT=/path/to/MURA-v1.1

# Local directory for experiment outputs
XRAY_OUTPUT_ROOT=outputs

# DataLoader worker count; adjust for the machine
XRAY_NUM_WORKERS=4